# Required: full HoYoLAB cookie string from your browser session.
# Must include at least ltoken_v2, ltuid_v2, and ltmid_v2 for check-in.
# For automatic code redemption, also include cookie_token_v2, account_mid_v2, and account_id_v2.
#
# How to obtain: log in at https://www.hoyolab.com, open DevTools → Application → Cookies,
# and copy the relevant cookie values into a single semicolon-separated string.
# Reference guide: https://gist.github.com/torikushiii/59eff33fc8ea89dbc0b2e7652db9d3fd
HOYOLAB_COOKIE=

# Enable or disable each game (true/false)
ENABLE_GENSHIN=true
ENABLE_HSR=true

# Directory for local state (processed codes cache)
STATE_DIR=data

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Scheduler: daily check-in time (24h, local timezone)
CHECKIN_HOUR=0
CHECKIN_MINUTE=5

# Scheduler: how often to poll for new codes (minutes)
REDEEM_INTERVAL_MINUTES=15

# HTTP timeout in seconds
HTTP_TIMEOUT=30

# Delay between redemption attempts (seconds) — HoYoLAB rate limits apply
REDEEM_DELAY_SECONDS=6
